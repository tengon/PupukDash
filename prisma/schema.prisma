generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model FertilizerProduct {
  id            String   @id @default(cuid())
  name          String
  type          String
  pricePerKg    Float
  description   String?
  subsidyPrice  Float
  imageUrl      String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  stock         Stock[]
  orderItems    OrderItem[]
  purchases     Purchase[]
}

model Farmer {
  id            String   @id @default(cuid())
  nik           String   @unique
  name          String
  phone         String?
  address       String?
  village       String?
  district      String?
  regency       String?
  province      String?
  landAreaHa    Float?
  farmerGroup   String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  orders        Order[]
}

model Warehouse {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  address       String
  district      String?
  regency       String?
  province      String
  managerName   String?
  managerPhone  String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  stock         Stock[]
  distributions Distribution[]
  orders        Order[]
  purchases     Purchase[]
}

model Stock {
  id              String            @id @default(cuid())
  warehouseId     String
  productId       String
  quantity        Float
  minStock        Float             @default(500)
  lastRestocked   DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  warehouse       Warehouse         @relation(fields: [warehouseId], references: [id])
  product         FertilizerProduct @relation(fields: [productId], references: [id])

  @@unique([warehouseId, productId])
}

model Distribution {
  id              String     @id @default(cuid())
  distributionNo  String     @unique
  warehouseId     String
  productId       String
  productName     String
  quantity        Float
  sourceRegency   String?
  targetVillage   String?
  targetGroup     String?
  status          String     @default("DRAFT")
  notes           String?
  distributedAt   DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  warehouse       Warehouse  @relation(fields: [warehouseId], references: [id])
}

model Order {
  id              String     @id @default(cuid())
  orderNumber     String     @unique
  farmerId        String
  warehouseId     String
  status          String     @default("PENDING")
  totalAmount     Float
  totalSubsidy    Float
  notes           String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  farmer          Farmer     @relation(fields: [farmerId], references: [id])
  warehouse       Warehouse  @relation(fields: [warehouseId], references: [id])
  items           OrderItem[]
}

model OrderItem {
  id              String            @id @default(cuid())
  orderId         String
  productId       String
  productName     String
  quantity        Float
  pricePerKg      Float
  subtotal        Float
  order           Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         FertilizerProduct @relation(fields: [productId], references: [id])
}

model ActivityLog {
  id        String   @id @default(cuid())
  action    String
  detail    String
  userId    String?
  createdAt DateTime @default(now())
}

model User {
  id            String   @id @default(cuid())
  username      String   @unique
  password      String
  name          String
  role          String   @default("OPERATOR") // ADMIN, OPERATOR, VIEWER
  ppstCode      String?
  ppstName      String?
  isActive      Boolean  @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Ppts {
  id            String   @id @default(cuid())
  code          String   @unique // No ID PPTS
  name          String   // Nama PPTS
  address       String   // Alamat
  district      String   // Kecamatan
  village       String?  // Desa / Kelurahan
  regency       String?  @default("Kudus") // Kota / Kabupaten
  province      String?  @default("Jawa Tengah") // Propinsi
  ownerName     String?  // Nama Pemilik
  phone         String?  // No Telepon
  spjbNumber    String?  // Nomor Dokument SPJB
  spjbDate      String?  // Tanggal Buat SPJB
  spjbValidFrom String?  // Mulai Berlaku
  spjbValidUntil String? // Berlaku Hingga
  alokasiUrea   Float?   // Alokasi SPJB Urea (Ton)
  alokasiNpk    Float?   // Alokasi SPJB NPK (Ton)
  realisasiUrea Float?   @default(0) // Realisasi Tebusan Urea (Ton)
  realisasiNpk  Float?   @default(0) // Realisasi Tebusan NPK (Ton)
  sisaUrea      Float?   // Sisa Alokasi Urea (Ton)
  sisaNpk       Float?   // Sisa Alokasi NPK (Ton)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Purchase {
  id              String            @id @default(cuid())
  purchaseNo      String            @unique
  supplierName    String            @default("PT Pupuk Indonesia (Persero)")
  warehouseId     String
  productId       String
  quantity        Float
  pricePerKg      Float
  totalAmount     Float
  status          String            @default("RECEIVED") // PENDING, RECEIVED, CANCELLED
  notes           String?
  purchasedAt     DateTime          @default(now())
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  warehouse       Warehouse         @relation(fields: [warehouseId], references: [id])
  product         FertilizerProduct @relation(fields: [productId], references: [id])
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  name      String
  email     String   @unique
  password  String
  role      String   @default("Administrator Distributor")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}