generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model FertilizerProduct {
  id            String   @id @default(cuid())
  name          String
  type          String
  pricePerKg    Float
  description   String?
  subsidyPrice  Float
  imageUrl      String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  stock         Stock[]
  orderItems    OrderItem[]
  purchases     Purchase[]
}

model Farmer {
  id            String   @id @default(cuid())
  nik           String   @unique
  name          String
  phone         String?
  address       String?
  village       String?
  district      String?
  regency       String?
  province      String?
  landAreaHa    Float?
  farmerGroup   String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  orders        Order[]
}

model Warehouse {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  address       String
  district      String?
  regency       String?
  province      String
  managerName   String?
  managerPhone  String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  stock         Stock[]
  distributions Distribution[]
  orders        Order[]
  purchases     Purchase[]
}

model Stock {
  id              String            @id @default(cuid())
  warehouseId     String
  productId       String
  quantity        Float
  minStock        Float             @default(500)
  lastRestocked   DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  warehouse       Warehouse         @relation(fields: [warehouseId], references: [id])
  product         FertilizerProduct @relation(fields: [productId], references: [id])

  @@unique([warehouseId, productId])
}

model Distribution {
  id              String     @id @default(cuid())
  distributionNo  String     @unique
  warehouseId     String
  productId       String
  productName     String
  quantity        Float
  sourceRegency   String?
  targetVillage   String?
  targetGroup     String?
  status          String     @default("DRAFT")
  notes           String?
  distributedAt   DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  warehouse       Warehouse  @relation(fields: [warehouseId], references: [id])
}

model Order {
  id              String     @id @default(cuid())
  orderNumber     String     @unique
  farmerId        String
  warehouseId     String
  status          String     @default("PENDING")
  totalAmount     Float
  totalSubsidy    Float
  notes           String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  farmer          Farmer     @relation(fields: [farmerId], references: [id])
  warehouse       Warehouse  @relation(fields: [warehouseId], references: [id])
  items           OrderItem[]
}

model OrderItem {
  id              String            @id @default(cuid())
  orderId         String
  productId       String
  productName     String
  quantity        Float
  pricePerKg      Float
  subtotal        Float
  order           Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         FertilizerProduct @relation(fields: [productId], references: [id])
}

model ActivityLog {
  id        String   @id @default(cuid())
  action    String
  detail    String
  userId    String?
  createdAt DateTime @default(now())
}

model User {
  id            String   @id @default(cuid())
  username      String   @unique
  password      String
  name          String
  role          String   @default("OPERATOR") // ADMIN, OPERATOR, VIEWER
  ppstCode      String?
  ppstName      String?
  isActive      Boolean  @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Ppts {
  id            String   @id @default(cuid())
  code          String   @unique // No ID PPTS
  name          String   // Nama PPTS
  address       String   // Alamat
  district      String   // Kecamatan
  village       String?  // Desa / Kelurahan
  regency       String?  @default("Kudus") // Kota / Kabupaten
  province      String?  @default("Jawa Tengah") // Propinsi
  ownerName     String?  // Nama Pemilik
  phone         String?  // No Telepon
  spjbNumber    String?  // Nomor Dokument SPJB
  spjbDate      String?  // Tanggal Buat SPJB
  spjbValidFrom String?  // Mulai Berlaku
  spjbValidUntil String? // Berlaku Hingga
  alokasiUrea   Float?   // Alokasi SPJB Urea (Ton)
  alokasiNpk    Float?   // Alokasi SPJB NPK (Ton)
  realisasiUrea Float?   @default(0) // Realisasi Tebusan Urea (Ton)
  realisasiNpk  Float?   @default(0) // Realisasi Tebusan NPK (Ton)
  sisaUrea      Float?   // Sisa Alokasi Urea (Ton)
  sisaNpk       Float?   // Sisa Alokasi NPK (Ton)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Purchase {
  id              String            @id @default(cuid())
  purchaseNo      String            @unique
  supplierName    String            @default("PT Pupuk Indonesia (Persero)")
  warehouseId     String
  productId       String
  quantity        Float
  pricePerKg      Float
  totalAmount     Float
  status          String            @default("RECEIVED") // PENDING, RECEIVED, CANCELLED
  notes           String?
  purchasedAt     DateTime          @default(now())
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  warehouse       Warehouse         @relation(fields: [warehouseId], references: [id])
  product         FertilizerProduct @relation(fields: [productId], references: [id])
}

model Allocation {
  id                  String   @id @default(cuid())
  year                String   @default("2026")
  type                String   @default("OPERASIONAL") // OPERASIONAL or PPTS
  spjbNumber          String?
  distributorName     String?
  producerName        String?
  pptsCode            String?
  pptsName            String?
  district            String?
  productName         String
  totalAllocationTon  Float    @default(0)
  totalRealizationTon Float    @default(0)
  totalApprovedSoTon  Float    @default(0)
  totalRemainingTon   Float    @default(0)
  realizationPct      Float    @default(0)
  janAlloc            Float    @default(0)
  febAlloc            Float    @default(0)
  marAlloc            Float    @default(0)
  aprAlloc            Float    @default(0)
  mayAlloc            Float    @default(0)
  junAlloc            Float    @default(0)
  julAlloc            Float    @default(0)
  augAlloc            Float    @default(0)
  sepAlloc            Float    @default(0)
  octAlloc            Float    @default(0)
  novAlloc            Float    @default(0)
  decAlloc            Float    @default(0)
  janReal            Float    @default(0)
  febReal            Float    @default(0)
  marReal            Float    @default(0)
  aprReal            Float    @default(0)
  mayReal            Float    @default(0)
  junReal            Float    @default(0)
  julReal            Float    @default(0)
  augReal            Float    @default(0)
  sepReal            Float    @default(0)
  octReal            Float    @default(0)
  novReal            Float    @default(0)
  decReal            Float    @default(0)
  rawJson             String?
  status              String   @default("Active")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([year, type])
  @@index([pptsCode])
  @@index([district])
}

// 1. Tabel Alokasi Bulanan Kecamatan (SPJB Operasional: Jan - Des)
model AlokasiBulananKecamatan {
  id          String   @id
  spjbNumber  String
  district    String
  productName String
  year        String   @default("2026")
  janAlloc    Float    @default(0)
  janSo       Float    @default(0)
  janReal     Float    @default(0)
  janSisa     Float    @default(0)
  febAlloc    Float    @default(0)
  febSo       Float    @default(0)
  febReal     Float    @default(0)
  febSisa     Float    @default(0)
  marAlloc    Float    @default(0)
  marSo       Float    @default(0)
  marReal     Float    @default(0)
  marSisa     Float    @default(0)
  aprAlloc    Float    @default(0)
  aprSo       Float    @default(0)
  aprReal     Float    @default(0)
  aprSisa     Float    @default(0)
  mayAlloc    Float    @default(0)
  maySo       Float    @default(0)
  mayReal     Float    @default(0)
  maySisa     Float    @default(0)
  junAlloc    Float    @default(0)
  junSo       Float    @default(0)
  junReal     Float    @default(0)
  junSisa     Float    @default(0)
  julAlloc    Float    @default(0)
  julSo       Float    @default(0)
  julReal     Float    @default(0)
  julSisa     Float    @default(0)
  augAlloc    Float    @default(0)
  augSo       Float    @default(0)
  augReal     Float    @default(0)
  augSisa     Float    @default(0)
  sepAlloc    Float    @default(0)
  sepSo       Float    @default(0)
  sepReal     Float    @default(0)
  sepSisa     Float    @default(0)
  octAlloc    Float    @default(0)
  octSo       Float    @default(0)
  octReal     Float    @default(0)
  octSisa     Float    @default(0)
  novAlloc    Float    @default(0)
  novSo       Float    @default(0)
  novReal     Float    @default(0)
  novSisa     Float    @default(0)
  decAlloc    Float    @default(0)
  decSo       Float    @default(0)
  decReal     Float    @default(0)
  decSisa     Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([district, productName])
}

// 2. Tabel Alokasi Tahun Kecamatan (SPJB Operasional: Total Alokasi - Total SO - Total SO Approve - Total Sisa)
model AlokasiTahunanKecamatan {
  id              String   @id
  spjbNumber      String
  district        String
  productName     String
  year            String   @default("2026")
  totalAlokasi    Float    @default(0)
  totalSo         Float    @default(0)
  totalSoApprove  Float    @default(0)
  totalSisa       Float    @default(0)
  realizationPct  Float    @default(0)
  sisaPct         Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([district, productName])
}

// 3. Tabel Alokasi PPTS (SPJB PPTS Kios)
model AlokasiPpts {
  id              String   @id
  pptsCode        String
  pptsName        String
  district        String?
  address         String?
  spjbNumber      String?
  productName     String
  year            String   @default("2026")
  totalAlokasi    Float    @default(0)
  totalRealisasi  Float    @default(0)
  totalSisa       Float    @default(0)
  realizationPct  Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([pptsCode, productName])
}

// 4. Tabel Surat Jalan Penyaluran Pengecer (Detail PKP Order)
model SuratJalan {
  id              String             @id @default(cuid())
  noSuratJalan    String             @unique
  uuid            String?
  nomorPkp        String?
  nomorOrder      String?
  kodeSo          String?
  kodeDistributor String?
  namaDistributor String?
  provinsi        String?
  kabupaten       String?
  kecamatan       String?
  kodeProdusen    String?
  namaProdusen    String?
  urea            String?
  npk             String?
  organik         String?
  npkKakao        String?
  za              String?
  sp36            String?
  status          String?
  tglSuratJalan   String?
  tglDibuat       String?
  tglDiubah       String?
  tglSyncIpubers  String?
  tglTerimaKios   String?
  asalPengambilan String?
  href            String?
  detail          String?            // JSON stringified detail (tables & labelValues)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  details         SuratJalanDetail[]

  @@index([noSuratJalan])
  @@index([kodeProdusen])
}

// 5. Tabel Detail Rincian Item Surat Jalan
model SuratJalanDetail {
  id            String      @id @default(cuid())
  suratJalanId  String?
  noSuratJalan  String
  kodeKios      String?
  namaKios      String?
  kecamatan     String?
  desa          String?
  namaProduk    String?
  jumlah        Float?      @default(0)
  satuan        String?     @default("Ton")
  keterangan    String?
  rawJson       String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  suratJalan    SuratJalan? @relation(fields: [suratJalanId], references: [id], onDelete: Cascade)

  @@index([noSuratJalan])
  @@index([suratJalanId])
}
